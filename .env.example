# Copie para .env.local e preencha com os valores do seu projeto Supabase.
# Painel do Supabase > Project Settings > API
#
# A chave anon pode aparecer no navegador: e para isso que ela existe,
# e quem protege os dados e o Row Level Security.
# A chave service_role NAO entra aqui nem em lugar nenhum do repositorio.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
